+#include <cstdio>
+#include <cstdlib>
+// TEST OBSERVATION ONLY: log snapshots; never modify output state.
+static void passthrough_trace(const char *event, const uint16_t *pwm)
+{
+    static FILE *fp = nullptr;
+    static bool opened = false;
+    if (!opened) {
+        opened = true;
+        const char *path = std::getenv("PASSTHROUGH_TRACE_FILE");
+        if (path) {fp = std::fopen(path, "w");if (fp) std::setvbuf(fp, nullptr, _IONBF, 0);}
+    }
+    if (fp) std::fprintf(fp, "%u,%s,%u,%u,%u,%u,%u,%u\n", AP_HAL::micros(), event,
+                         pwm[0], pwm[1], pwm[2], pwm[3], pwm[4], pwm[5]);
+}
+
 
